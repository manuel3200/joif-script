#!/bin/bash
# =========================================================================
# JOIF Cloud v2.0 — Instalador Limpio, Seguro e Idempotente (Ubuntu 22/24/26)
# =========================================================================

set -u

red='\033[1;31m'
green='\033[1;32m'
yellow='\033[1;33m'
blue='\033[1;34m'
cyan='\033[1;36m'
white='\033[1;37m'
gray='\033[0;90m'
plain='\033[0m'

if [ "$(id -u)" -ne 0 ]; then
    echo -e "${red}✖ Este instalador debe ejecutarse como root.${plain}"
    exit 1
fi

OS=$(grep -m1 '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d'"' -f2 || echo "Linux")
CPU=$(lscpu 2>/dev/null | awk -F: '/Model name/ {gsub(/^[ \t]+/, "", $2); print $2; exit}')
[ -z "$CPU" ] && CPU="$(uname -m)"
IP=$(curl -fsS --connect-timeout 3 --max-time 4 https://api.ipify.org 2>/dev/null || curl -fsS --connect-timeout 3 --max-time 4 https://ifconfig.me 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}')
IP="${IP:-127.0.0.1}"

clear
echo -e "${cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${plain}"
echo -e "${cyan}        _  ___ ___ _____   ____ _     ___  _   _ ____  ${plain}"
echo -e "${cyan}       | |/ _ \_ _|  ___| / ___| |   / _ \| | | |  _ \ ${plain}"
echo -e "${cyan}    _  | | | | | || |_   | |   | |  | | | | | | | | | |${plain}"
echo -e "${cyan}   | |_| | |_| | ||  _|  | |___| |__| |_| | |_| | |_| |${plain}"
echo -e "${cyan}    \___/ \___/___|_|     \____|_____\___/ \___/|____/ ${plain}"
echo -e "${cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${plain}"
echo -e "  ${gray}Versión:${plain} ${white}v2.0 (Ubuntu 22.04 / 24.04 / 26.04 LTS)${plain}"
echo -e "  ${gray}Sistema:${plain} ${green}${OS}${plain}  ${gray}│  IP:${plain} ${yellow}${IP}${plain}"
echo -e "  ${gray}CPU:    ${plain} ${white}${CPU}${plain}"
echo -e "${cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${plain}"
read -r -p "$(echo -e "${yellow}Presiona [Enter] para iniciar la instalación...${plain}")"

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
if [ -f /etc/needrestart/needrestart.conf ]; then
    sed -i "s/#\?\$nrconf{restart} = 'i';/\$nrconf{restart} = 'a';/g" /etc/needrestart/needrestart.conf 2>/dev/null || true
fi

echo -e "\n${blue}[1/6] Instalando paquetes base...${plain}"
apt-get update -qq >/dev/null 2>&1
paquetes=("curl" "wget" "git" "unzip" "sqlite3" "net-tools" "lsof" "jq" "psmisc" "iptables" "dnsutils" "openssl")
for pkg in "${paquetes[@]}"; do
    if apt-get install -y -qq "$pkg" >/dev/null 2>&1; then
        echo -e "  ${green}✔${plain} ${pkg}"
    else
        echo -e "  ${red}✖${plain} ${pkg} (falló)"
    fi
done

# Limpiar proxies heredados conflictivos en puerto 80
for old_svc in nginx apache2 caddy lighttpd python-proxy epro eproxy wsproxy; do
    systemctl stop "$old_svc" 2>/dev/null || true
    systemctl disable "$old_svc" 2>/dev/null || true
done
pkill -9 -f "PDirect|P3Direct|PPub|PPriv|wsproxy|epro" 2>/dev/null || true

echo -e "\n${blue}[2/6] Verificando Node.js...${plain}"
if ! command -v node >/dev/null 2>&1; then
    apt-get install -y -qq nodejs npm >/dev/null 2>&1 || true
    if ! command -v node >/dev/null 2>&1; then
        curl -fsSL --connect-timeout 10 https://deb.nodesource.com/setup_20.x 2>/dev/null | bash - >/dev/null 2>&1
        apt-get install -y -qq nodejs >/dev/null 2>&1
    fi
fi
NODE_BIN=$(command -v node 2>/dev/null || echo "/usr/bin/node")
echo -e "  ${green}✔${plain} Node.js listo ($("$NODE_BIN" -v 2>/dev/null || echo 'OK'))"

echo -e "\n${blue}[3/6] Configurando dominio del nodo...${plain}"
read -r -p "$(echo -e "${white}Dominio del VPS (Enter para usar ${IP}): ${plain}")" user_domain
user_domain="${user_domain:-$IP}"
echo "$user_domain" > /root/.JOIF_domain

echo -e "\n${blue}[4/6] Descargando núcleo JOIF Cloud desde GitHub...${plain}"
GIT_REPO_URL="${GIT_REPO_URL:-https://github.com/manuel3200/joif-script.git}"
if [ -d "/root/joif-core/.git" ]; then
    cd /root/joif-core && git fetch origin main >/dev/null 2>&1 && git reset --hard origin/main >/dev/null 2>&1
else
    rm -rf /root/joif-core
    git clone --depth 1 "$GIT_REPO_URL" /root/joif-core >/dev/null 2>&1
fi

if [ ! -f "/root/joif-core/menu.sh" ]; then
    echo -e "${red}✖ Error: No se pudo descargar /root/joif-core desde ${GIT_REPO_URL}.${plain}"
    exit 1
fi

cd /root/joif-core
if [ ! -d "node_modules/express" ]; then
    npm install --omit=dev --no-audit --no-fund >/dev/null 2>&1
fi

chmod +x /root/joif-core/menu.sh /root/joif-core/update.sh /root/joif-core/limitador.sh 2>/dev/null || true
chmod -R +x /root/joif-core/core /root/joif-core/modules 2>/dev/null || true

unalias menu 2>/dev/null || true
sed -i '/alias menu=/d' /root/.bashrc 2>/dev/null || true
rm -f /usr/local/bin/menu /bin/menu
ln -sf /root/joif-core/menu.sh /usr/bin/menu
ln -sf /root/joif-core/update.sh /usr/bin/joif-update
ln -sf /root/joif-core/modules/system/network_tuning.sh /usr/bin/joif-bbr
ln -sf /root/joif-core/modules/system/network_tuning.sh /usr/bin/bbr
ln -sf /root/joif-core/modules/network/smartdns_client.sh /usr/local/bin/joif-smartdns
ln -sf /root/joif-core/modules/network/firewall_manager.sh /usr/local/bin/joif-firewall
hash -r

# Generar .env con API_KEY única criptográfica (nunca fija en instalaciones nuevas)
echo -e "\n${blue}[5/6] Configurando entorno seguro y servicio joif.service...${plain}"
if [ ! -f /root/joif-core/.env ]; then
    GEN_API_KEY=$(openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
    cat << EOF > /root/joif-core/.env
PORT=3000
API_KEY=${GEN_API_KEY}
NODE_API_SECRET=${GEN_API_KEY}
EOF
    echo -e "  ${green}✔${plain} API_KEY aleatoria generada en /root/joif-core/.env"
else
    echo -e "  ${green}✔${plain} Archivo .env existente conservado."
fi
chmod 600 /root/joif-core/.env

# Limpiar servicio duplicado heredado si existía
if systemctl list-unit-files 2>/dev/null | grep -q '^joif-api\.service'; then
    systemctl stop joif-api 2>/dev/null || true
    systemctl disable joif-api 2>/dev/null || true
    rm -f /etc/systemd/system/joif-api.service
fi

cat << EOF > /etc/systemd/system/joif.service
[Unit]
Description=JOIF Web Panel and CheckUser API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/joif-core
ExecStart=${NODE_BIN} server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable joif >/dev/null 2>&1
systemctl restart joif

# Firewall idempotente y OpenSSH seguro (con validación sshd -t)
echo -e "\n${blue}[6/6] Aplicando reglas de firewall y configuración segura OpenSSH...${plain}"
source /root/joif-core/core/utils.sh 2>/dev/null || true
for p in 22 80 443 3000 7300; do
    ensure_firewall_port "$p" "tcp"
done
ensure_firewall_port 7300 "udp"
ensure_firewall_port 7200 "udp"
bash /root/joif-core/modules/network/firewall_manager.sh --enable-default >/dev/null 2>&1 || true
persist_firewall

grep -qxF '/bin/false' /etc/shells 2>/dev/null || echo '/bin/false' >> /etc/shells
mkdir -p /etc/ssh/sshd_config.d
cat << 'EOF' > /etc/ssh/sshd_config.d/01-password-auth.conf
PasswordAuthentication yes
KbdInteractiveAuthentication yes
PermitEmptyPasswords no
ClientAliveInterval 30
ClientAliveCountMax 2
EOF
safe_reload_ssh || echo -e "  ${yellow}⚠ No se pudo recargar SSH automáticamente; revisa sshd -t.${plain}"

clear
echo -e "${cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${plain}"
echo -e "  ${green}✅ JOIF CLOUD v2.0 INSTALADO Y OPERATIVO${plain}"
echo -e "${cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${plain}"
echo -e "  ${gray}Dominio / IP :${plain} ${yellow}${user_domain}${plain} (${IP})"
echo -e "  ${gray}Panel Web    :${plain} ${cyan}http://${user_domain}:3000/${plain} ${gray}(o http://${user_domain}/panel/ vía WS :80)${plain}"
echo -e "  ${gray}Protección   :${plain} ${green}Escudo Anti-Torrent + Anti-SPAM activado${plain}"
echo -e "  ${gray}Consola      :${plain} Escribe ${green}menu${plain} para administrar el servidor"
echo -e "${cyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${plain}"
read -r -p "$(echo -e "${gray}Presiona [Enter] para finalizar...${plain}")"
clear
